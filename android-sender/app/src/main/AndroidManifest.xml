<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only what the implementation needs (spec "Android permissions and services"). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Keeps the link to the glasses (a network-attached device) alive while the screen is off;
         without a foreground service the platform tears the socket down on lock. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Extended-screen mode lists apps that have a launcher entry so they can be started on the
         glasses display. This is the sanctioned alternative to QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".app.MirrorApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RokidMirror"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="35">

        <activity
            android:name=".app.ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The extended screen's own content. Android refuses to move other apps to a virtual
             display an ordinary app created, but our own activity is allowed there. -->
        <activity
            android:name=".app.GlassesWorkspaceActivity"
            android:exported="false"
            android:label="@string/workspace_label"
            android:resizeableActivity="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.RokidMirror"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|smallestScreenSize" />

        <!-- Mouse mode: the only no-root way to deliver a tap to another app. Configured with no
             event types and no window-content access, so it cannot read the screen. -->
        <service
            android:name=".app.PointerService"
            android:exported="false"
            android:label="@string/pointer_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/pointer_service_config" />
        </service>

        <!-- Foreground service of type mediaProjection: required before getMediaProjection on Android 14+. -->
        <service
            android:name=".app.MirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|connectedDevice" />
    </application>
</manifest>
